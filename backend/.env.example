# Integration Atlas backend configuration. Copy to backend/.env and fill in.
# Every key is optional: with none set, the app still serves seed guides.
# Never commit real keys.

ENVIRONMENT=development

# --- Application-default LLM (used when a visitor has not entered their own key) ---
# Provider: anthropic | openai | openrouter. Only the selected provider needs a key.
DEFAULT_LLM_PROVIDER=openrouter
# Use a real model ID from the provider, e.g.
#   anthropic:  claude-sonnet-5-5
#   openai:     gpt-5.5
#   openrouter: anthropic/claude-sonnet-5.5, openai/gpt-5.5, nvidia/nemotron-3-super-120b-a12b
DEFAULT_LLM_MODEL=replace_with_a_supported_model_id

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Web search for live research (https://tavily.com) ---
# Without it, research still works when the user enters a documentation URL.
TAVILY_API_KEY=

# --- Storage ---
# Local default is SQLite. For Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./atlas.db
# Production runs `alembic upgrade head` and sets this to false.
AUTO_CREATE_TABLES=true

# --- Sessions & security ---
# Long random string; signs the anonymous-browser and BYOK session cookies.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_a_long_random_string
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Origins allowed to make state-changing requests (the frontend URL), comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Sent to OpenRouter as HTTP-Referer.
PUBLIC_APP_URL=http://localhost:3000
# How long a bring-your-own key stays in server memory.
BYOK_TTL_MINUTES=60

# --- Rate limits ---
RATE_LIMIT_LLM_CONFIG_PER_MINUTE=5
RATE_LIMIT_RESEARCH_DEFAULT_PER_HOUR=6
RATE_LIMIT_RESEARCH_BYOK_PER_HOUR=20
RATE_LIMIT_CHAT_PER_HOUR=30
